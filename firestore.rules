rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists() ? userDoc.data.role : null;
    }

    function normalizedUserRole() {
      let role = getUserRole();
      return role is string ? role.toLowerCase() : null;
    }

    function isAdmin() {
      return isSignedIn() && normalizedUserRole() == 'admin';
    }

    function isRecruiter() {
      return isSignedIn() && normalizedUserRole() == 'recruiter';
    }

    function isStudent() {
      return isSignedIn() && normalizedUserRole() == 'student';
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        (isRecruiter() || isAdmin()) ||
        (request.resource.data.postedBy == request.auth.uid && request.resource.data.companyId == request.auth.uid)
      ) &&
      request.resource.data.title is string &&
      request.resource.data.companyName is string &&
      request.resource.data.description is string;
      allow update, delete: if (isRecruiter() && resource.data.postedBy == request.auth.uid) || isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAdmin() || resource.data.studentId == request.auth.uid || (exists(/databases/$(database)/documents/jobs/$(resource.data.jobId)) && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid);
      allow update: if isAdmin() || (isRecruiter() && exists(/databases/$(database)/documents/jobs/$(resource.data.jobId)) && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid) || (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }

    match /messages/{messageId} {
      allow create: if isSignedIn() && request.resource.data.from == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow update, delete: if false;
    }

    match /adminCredentials/{docId} {
      allow read, write: if isAdmin();
    }

    match /interviews/{interviewId} {
      allow create: if isRecruiter() && request.resource.data.recruiterId == request.auth.uid;
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.recruiterId ||
        isAdmin()
      );
      allow update, delete: if false;
    }
  }
}
